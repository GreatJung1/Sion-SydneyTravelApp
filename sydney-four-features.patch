+/* ===== FOUR FEATURES: 저장 필터·길찾기·방문·일정 경비 ===== */
+.trip-saved-controls { display:grid; gap:10px; margin:14px 0; }
+.trip-saved-filter, .trip-saved-extra { display:flex; gap:7px; flex-wrap:wrap; align-items:center; }
+.trip-saved-filter button, .trip-saved-extra button, .trip-saved-extra select {
+  border:1px solid #d5dacd; border-radius:10px; padding:9px 12px;
+  background:white; color:#59674f; font-size:12px; font-weight:700;
+}
+.trip-saved-filter button.active, .trip-saved-extra button.active {background:#626f52;color:white;}
+.trip-saved-extra button {display:flex;align-items:center;gap:5px;}
+.trip-saved-extra label {display:flex;align-items:center;gap:6px;font-size:12px;color:#626f52;}
+.trip-saved-controls small {color:#737d6e;font-size:11px;}
+.trip-collection-icon {background:transparent;border:none;}
+.trip-collection-icon span {display:grid;place-items:center;width:28px;height:28px;
+  border-radius:50%;border:2px solid white;box-sizing:border-box;
+  font-size:17px;font-weight:900;box-shadow:0 2px 9px #0003;}
+.trip-collection-icon .completed {background:#506b44;color:white;}
+.trip-collection-icon .pending {background:#c5a78a;color:#533d2b;}
+.trip-visit-action {display:grid;place-items:center;flex:0 0 30px;height:30px;
+  background:#f2f3ec;color:#78846e;border:1px solid #d5dacd;border-radius:50%;}
+.trip-visit-action[aria-pressed="true"] {background:#526b48;color:white;border-color:#526b48;}
+.trip-visited-tag {color:#526b48!important;letter-spacing:0!important;font-size:10px!important;}
+.trip-stop-tools {display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:2px;}
+.trip-stop-tools button,.trip-stop-tools a {font-size:11px!important;color:#536a47;
+  border:1px solid #d6dfcf;border-radius:8px;padding:5px 7px;background:white;
+  text-decoration:none;font-weight:700;}
+.trip-stop-spent {color:#795a3d;font-size:11px;font-weight:800;}
+.place-row {gap:8px;}
+.place-name {overflow-wrap:anywhere;}
