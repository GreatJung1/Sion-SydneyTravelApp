+/* ===== FOUR FEATURES: 경비와 일정 선택형 연결 ===== */
+.trip-exp-link {margin:2px 0 19px;display:grid;gap:9px;}
+.trip-exp-link-heading {display:flex;justify-content:space-between;align-items:center;color:#4c5845;font-size:12px;}
+.trip-exp-link-heading small {color:#8a9286;}
+.trip-exp-chosen {display:flex;align-items:center;gap:8px;background:#e9eee4;
+  border-radius:10px;padding:9px;font-size:12px;color:#4e6046;}
+.trip-exp-chosen span {flex:1;overflow-wrap:anywhere;}
+.trip-exp-chosen button {border:0;background:transparent;color:#6f5840;font-weight:700;}
+.trip-exp-picker-button {width:100%;border:1px solid #cbd8c1;background:#fff;
+  color:#536a49;border-radius:11px;padding:13px;font-size:13px;font-weight:800;}
+.trip-exp-picker-overlay {position:fixed;inset:0;z-index:200;
+  display:flex;justify-content:center;background:#f6f5f1;overflow-y:auto;}
+.trip-exp-picker-page {width:min(100%, 550px);padding:calc(20px + env(safe-area-inset-top)) 20px
+  calc(30px + env(safe-area-inset-bottom));box-sizing:border-box;}
+.trip-exp-picker-head {display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;}
+.trip-exp-picker-head span {font-size:10px;letter-spacing:.15em;color:#819077;}
+.trip-exp-picker-head h2 {margin:3px 0;font-size:27px;color:#34402f;}
+.trip-exp-picker-head button {background:white;border:1px solid #dde4d7;border-radius:50%;width:37px;height:37px;}
+.trip-exp-picker-list {display:grid;gap:0;margin:16px 0 20px;}
+.trip-exp-picker-stop {width:100%;display:flex;align-items:center;gap:13px;text-align:left;
+  border:0;border-bottom:1px solid #dde2d8;background:transparent;padding:13px 4px;color:#384234;}
+.trip-exp-picker-time {width:56px;flex-shrink:0;font-size:12px;color:#8b9384;font-weight:800;}
+.trip-exp-picker-desc {flex:1;display:grid;gap:5px;min-width:0;}
+.trip-exp-picker-desc strong {font-size:13px;}
+.trip-exp-picker-desc small {font-size:11px;color:#8c9387;}
+.trip-exp-picker-back {width:100%;padding:13px;border-radius:12px;background:#637456;
+  color:white;border:0;font-weight:800;}
